{
  "name": "search-select-vue",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/search-select.umd.cjs",
  "module": "./dist/search-select.es.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/search-select.es.js",
      "require": "./dist/search-select.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepublishOnly": "npm test && npm run build"
  },
  "description": "A versatile search-select component for Vue 3 and Nuxt 3 with support for local/remote search, multi-select, custom templates, and more",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "nuxt3",
    "select",
    "search",
    "dropdown",
    "multiselect",
    "component"
  ],
  "author": "jithin003",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jithin003/search-select.git"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.12",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.4"
  }
}
